  "escenas": [
    {
      "texto": "En 1859, Estados Unidos y Gran Bretaña se disputaban las islas San Juan.",
      "decorado": "campo",
      "plano": "general",
      "rotulo": "Isla San Juan, 1859",
      "personajes": [
        {
          "rol": "granjero",
