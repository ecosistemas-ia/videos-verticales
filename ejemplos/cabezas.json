          "mira": "camara"
        },
        {
          "rol": "cerdo",
          "accion": "quieto",
          "posicion": "fondo_derecha"
        }
      ]
    },
    {
      "texto": "Un granjero estadounidense encontró a un cerdo comiéndose su huerto.",
      "decorado": "campo",
      "plano": "medio",
      "personajes": [
        {
          "rol": "granjero",
          "accion": "sorprende",
          "posicion": "izquierda"
        },
        {
          "rol": "cerdo",
          "accion": "camina",
          "posicion": "derecha"
        }
      ]
    },
    {
      "texto": "Le disparó. El cerdo era de una compañía británica.",
      "decorado": "campo",
      "plano": "medio",
      "personajes": [
        {
          "rol": "granjero",
          "accion": "señala",
          "posicion": "izquierda"
        },
        {
          "rol": "cerdo",
          "accion": "cae",
          "posicion": "derecha"
        }
      ]
    },
    {
      "texto": "Ofreció pagarlo, pero los británicos amenazaron con arrestarlo.",
      "decorado": "casa",
      "plano": "medio",
      "personajes": [
        {
          "rol": "granjero",
          "accion": "habla",
          "posicion": "izquierda",
          "lleva": "bolsa"
        },
        {
          "rol": "hombre",
          "accion": "señala",
          "posicion": "derecha"
        }
      ]
    },
    {
      "texto": "Estados Unidos mandó 64 soldados para proteger a sus colonos.",
      "decorado": "campamento",
      "plano": "general",
      "personajes": [
        {
          "rol": "soldado",
          "accion": "camina",
          "posicion": "centro",
          "lleva": "bandera"
        }
      ],
      "multitud": {
        "rol": "soldado",
        "accion": "camina",
        "cantidad": 5
      }
    },
    {
      "texto": "Gran Bretaña respondió con tres barcos de guerra.",
      "decorado": "barco",
      "plano": "general",
      "personajes": [
        {
          "rol": "capitan",
          "accion": "señala",
          "posicion": "centro",
          "mira": "derecha",
          "lleva": "catalejo"
        },
        {
          "rol": "marinero",
          "accion": "quieto",
          "posicion": "fondo_izquierda"
        },
        {
          "rol": "marinero",
          "accion": "saluda",
          "posicion": "fondo_derecha"
        }
      ]
    },
    {
      "texto": "En agosto ya había 461 soldados frente a 52 cañones británicos.",
      "decorado": "campamento",
      "plano": "picado",
      "hora": "noche",
      "personajes": [
        {
          "rol": "soldado",
          "accion": "quieto",
          "posicion": "centro",
          "lleva": "bandera"
        }
      ],
      "multitud": {
        "rol": "soldado",
        "accion": "quieto",
        "cantidad": 12
      }
    },
    {
      "texto": "Pero el almirante británico se negó a pelear por un cerdo.",
      "decorado": "barco",
      "plano": "primer_plano",
      "personajes": [
        {
          "rol": "capitan",
